# Gemini API key used by the discovery agent; not required for replay or for CI.
GEMINI_API_KEY=

# Model for the discovery loop. Free tier is 20 requests per DAY per model, and one
# discovery run costs 8-9. Quotas are per-model, so switching this opens a fresh budget.
GEMINI_MODEL=gemini-3.1-flash-lite

# Which LLMClient build_llm() constructs. Only "gemini" is implemented; the registry exists so
# a second provider is a config change, not a rewrite of the agent loop.
LLM_PROVIDER=gemini

# 429 backoff tuning for llm/gemini.py, in case the free tier's real per-minute shape needs a
# wider retry window than the defaults (5 attempts, 1s base delay, doubling with jitter).
GEMINI_MAX_ATTEMPTS=5
GEMINI_BASE_DELAY_S=1